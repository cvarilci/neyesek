# Bu dosyayı .env olarak kopyala ve kendi değerlerini yaz.
# .env dosyası .gitignore içindedir, asla commit etme.

# Django gizli anahtarı. Üretmek için:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Yerelde geliştirirken True, üretimde mutlaka False olmalı.
DEBUG=False

# Virgülle ayrılmış host listesi, örn: 127.0.0.1,localhost
ALLOWED_HOSTS=

# Virgülle ayrılmış origin listesi, örn: http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=

# Supabase Project Settings > Database > Connection string > Transaction pooler
# (port 6543). Boş bırakılırsa yerel SQLite veritabanı kullanılır.
DATABASE_URL=
